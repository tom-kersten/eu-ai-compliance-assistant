# Offline overrides. Copy to .env.offline and adjust for local vLLM.
# Start with: make up-offline
# See docs/OFFLINE.md for hardware, quantization, and verified flags.

# Database (same as online unless you change it)
DB_PASSWORD=app
DATABASE_URL=postgresql://app:app@db:5432/compliance

# LLM (self-hosted vLLM)
LLM_BASE_URL=http://vllm-llm:8000/v1
LLM_API_KEY=
SELECTION_MODEL=qwen/qwen3.8-27b
ANSWER_MODEL=qwen/qwen3.8-27b
ANSWER_REASONING_EFFORT=medium
# Same measured default as the online profile.
SELECTION_REASONING_EFFORT=low

# Embeddings (self-hosted vLLM)
EMBEDDING_BASE_URL=http://vllm-embed:8000/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=2000
EMBEDDING_BATCH_SIZE=100

# Retrieval and chunking
RETRIEVAL_TOP_K=10
# Measured so Q09 is rejected and Q01-Q08 are admitted.
SIMILARITY_THRESHOLD=0.5959
# Longest via_reference list in the eval set.
MAX_ADDED_PROVISIONS=1
SPLIT_TOKEN_LIMIT=30000
# Counts retrieved provision tokens only (see app/pipeline/budget.py).
# Set to about half of LLM_MAX_MODEL_LEN so the prompt template, question,
# and completion still fit inside the vLLM context window.
PROMPT_TOKEN_BUDGET=4096
RETRIEVAL_HISTORY_TURNS=5

# LLM client behaviour
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# Compose-only: Hugging Face ids for vLLM --model (not in app/config.py).
# --served-model-name stays SELECTION_MODEL / EMBEDDING_MODEL above.
LLM_LOCAL_MODEL=Qwen/Qwen3.8-27B
EMBEDDING_LOCAL_MODEL=Qwen/Qwen3-Embedding-8B
# Hardware-conservative example; the model nominal window is larger.
LLM_MAX_MODEL_LEN=8192
# Extra vLLM CLI flags (compose string expansion). Quantization goes here,
# e.g. --quantization fp8, or set LLM_LOCAL_MODEL=Qwen/Qwen3.8-27B-FP8.
# Leave empty for BF16 when VRAM allows.
VLLM_LLM_EXTRA_ARGS=
# Pooling runner is required for embedding models. Optional Matryoshka
# override for dimensions=2000 is documented in docs/OFFLINE.md (quoting).
VLLM_EMBED_EXTRA_ARGS=--runner pooling
SERVING_PROFILE=offline
