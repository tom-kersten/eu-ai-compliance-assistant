# Online defaults. Copy to .env and fill secrets before `make up`.

# Database
DB_PASSWORD=app
DATABASE_URL=postgresql://app:app@db:5432/compliance

# LLM (OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
SELECTION_MODEL=qwen/qwen3.8-27b
ANSWER_MODEL=qwen/qwen3.8-27b
ANSWER_REASONING_EFFORT=medium
# To be decided in T17.
SELECTION_REASONING_EFFORT=

# Embeddings (OpenRouter)
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=2000

# Retrieval and chunking
RETRIEVAL_TOP_K=10
# To be tuned in T17.
SIMILARITY_THRESHOLD=
# To be tuned in T17.
MAX_ADDED_PROVISIONS=
SPLIT_TOKEN_LIMIT=30000
# To be tuned per profile.
PROMPT_TOKEN_BUDGET=
RETRIEVAL_HISTORY_TURNS=5

# LLM client behaviour
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
